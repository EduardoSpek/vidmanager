{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidManager",
  "version": "0.1.0",
  "identifier": "com.vidmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VidManager",
        "width": 1220,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#07090d",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http: https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "VidManager",
    "category": "Utility",
    "shortDescription": "Gerenciador de downloads de video",
    "longDescription": "Baixe videos, playlists e audio de sites suportados pelo yt-dlp com fila, pausa e retomada.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  }
}
