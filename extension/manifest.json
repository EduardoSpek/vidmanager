{
  "manifest_version": 3,
  "name": "VidManager",
  "version": "1.0.0",
  "description": "Envia vídeos da página atual para o VidManager com um clique.",
  "permissions": ["activeTab", "tabs", "storage", "cookies", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Enviar para VidManager",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
